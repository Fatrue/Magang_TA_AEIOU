generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum DeviceType {
  MAIN_CONTROLLER
  SENSOR_NODE
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum IrrigationMode {
  MANUAL
  AUTOMATIC
  SYSTEM
}

enum IrrigationTrigger {
  USER
  SCHEDULE
  FUZZY
  SYSTEM
}

enum IrrigationSessionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  EMERGENCY_STOP
}

enum IrrigationLogStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum MqttDirection {
  PUBLISH
  RECEIVE
}

model User {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(100)
  email              String              @unique @db.VarChar(150)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  role               UserRole            @default(OPERATOR)

  irrigationSessions IrrigationSession[]
  auditLogs          AuditLog[]

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  @@map("users")
}

model Device {
  id              Int              @id @default(autoincrement())
  deviceId        String           @unique @map("device_id") @db.VarChar(50)
  name            String           @db.VarChar(100)
  type            DeviceType
  status          DeviceStatus     @default(OFFLINE)
  lastSeen        DateTime?        @map("last_seen")

  sensorReadings  SensorReading[]
  mqttLogs        MqttLog[]

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("devices")
}

model Zone {
  id                Int              @id @default(autoincrement())
  zoneNumber        Int              @unique @map("zone_number")
  name              String           @db.VarChar(100)
  sprinklerCount    Int              @default(0) @map("sprinkler_count")
  defaultDuration   Int              @default(300) @map("default_duration")
  enabled           Boolean          @default(true)

  irrigationLogs   IrrigationLog[]

  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@map("zones")
}

model SensorReading {
  id               BigInt    @id @default(autoincrement())
  deviceId         Int       @map("device_id")
  soilMoisture     Decimal?  @map("soil_moisture") @db.Decimal(5, 2)
  temperature      Decimal?  @db.Decimal(5, 2)
  humidity         Decimal?  @db.Decimal(5, 2)
  fuzzyOutput      Decimal?  @map("fuzzy_output") @db.Decimal(5, 2)
  batteryVoltage   Decimal?  @map("battery_voltage") @db.Decimal(6, 2)
  rssi             Int?
  timestamp        DateTime  @default(now())

  device           Device    @relation(
    fields: [deviceId],
    references: [id],
    onDelete: Cascade
  )

  @@index([deviceId, timestamp])
  @@index([timestamp])
  @@map("sensor_readings")
}

model IrrigationSession {
  id           BigInt                   @id @default(autoincrement())
  requestId    String                   @unique @map("request_id") @db.VarChar(50)
  mode         IrrigationMode
  trigger      IrrigationTrigger
  startedAt    DateTime?                @map("started_at")
  finishedAt   DateTime?                @map("finished_at")
  status       IrrigationSessionStatus  @default(QUEUED)
  createdById  Int?                     @map("created_by")

  createdBy    User?                    @relation(
    fields: [createdById],
    references: [id],
    onDelete: SetNull
  )

  logs         IrrigationLog[]

  @@index([status])
  @@index([startedAt])
  @@index([createdById])
  @@map("irrigation_sessions")
}

model IrrigationLog {
  id          BigInt              @id @default(autoincrement())
  sessionId   BigInt              @map("session_id")
  zoneId      Int                 @map("zone_id")
  sequenceNo  Int                 @map("sequence_no")
  startTime   DateTime?           @map("start_time")
  endTime     DateTime?            @map("end_time")
  duration    Int
  status      IrrigationLogStatus @default(QUEUED)
  requestId   String              @map("request_id") @db.VarChar(50)
  createdAt   DateTime             @default(now()) @map("created_at")

  session     IrrigationSession   @relation(
    fields: [sessionId],
    references: [id],
    onDelete: Cascade
  )

  zone        Zone                @relation(
    fields: [zoneId],
    references: [id],
    onDelete: Restrict
  )

  @@index([sessionId, sequenceNo])
  @@index([zoneId, startTime])
  @@index([requestId])
  @@map("irrigation_logs")
}

model Schedule {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(100)
  time        DateTime  @db.Time(0)
  mode        IrrigationMode @default(AUTOMATIC)
  days        Json
  enabled     Boolean   @default(true)
  version     Int       @default(1)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([enabled, time])
  @@map("schedules")
}

model SystemSetting {
  id           Int      @id @default(autoincrement())
  settingKey   String   @unique @map("setting_key") @db.VarChar(100)
  settingValue String   @map("setting_value") @db.VarChar(255)

  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String   @db.VarChar(100)
  resource    String   @db.VarChar(100)
  resourceId  String?  @map("resource_id") @db.VarChar(50)
  requestId   String?  @map("request_id") @db.VarChar(50)
  details     Json?
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull
  )

  @@index([userId, createdAt])
  @@index([requestId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model MqttLog {
  id         BigInt        @id @default(autoincrement())
  topic      String        @db.VarChar(255)
  direction  MqttDirection
  payload    Json
  deviceId   Int?          @map("device_id")
  requestId  String?       @map("request_id") @db.VarChar(50)
  timestamp  DateTime      @default(now())

  device     Device?       @relation(
    fields: [deviceId],
    references: [id],
    onDelete: SetNull
  )

  @@index([topic, timestamp])
  @@index([deviceId, timestamp])
  @@index([requestId])
  @@map("mqtt_logs")
}
