// ============================================================
// Prisma Schema - Sistem Irigasi IoT BRMP Jakarta
// Database: MySQL
// ORM: Prisma
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  ADMIN
  OPERATOR
}

enum DeviceType {
  MAIN_CONTROLLER
  SENSOR_NODE
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  ERROR
}

enum IrrigationMode {
  MANUAL
  AUTOMATIC
  SYSTEM
}

enum IrrigationTrigger {
  USER
  SCHEDULE
  FUZZY
  SYSTEM
}

enum IrrigationSessionStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  EMERGENCY_STOP
}

enum IrrigationLogStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScheduleType {
  RECURRING
  ONCE
}

enum ScheduleMode {
  FIXED
  FUZZY
}

enum MqttDirection {
  PUBLISH
  RECEIVE
}


// ============================================================
// 1. USERS
// ============================================================

model User {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(150)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         UserRole @default(OPERATOR)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  irrigationSessions IrrigationSession[]
  auditLogs          AuditLog[]

  @@map("users")
}


// ============================================================
// 2. DEVICES
// ============================================================

model Device {
  id       Int          @id @default(autoincrement())
  deviceId String       @unique @map("device_id") @db.VarChar(50)
  name     String       @db.VarChar(100)
  type     DeviceType
  status   DeviceStatus @default(OFFLINE)

  lastSeen DateTime? @map("last_seen")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  sensorReadings SensorReading[]
  mqttLogs       MqttLog[]

  @@map("devices")
}


// ============================================================
// 3. ZONES
// ============================================================

model Zone {
  id              Int     @id @default(autoincrement())
  zoneNumber      Int     @unique @map("zone_number")
  name            String  @db.VarChar(100)
  sprinklerCount  Int     @map("sprinkler_count")
  defaultDuration Int     @map("default_duration")
  enabled         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  irrigationLogs IrrigationLog[]
  scheduleZones  ScheduleZone[]

  @@map("zones")
}


// ============================================================
// 4. SENSOR READINGS
// ============================================================

model SensorReading {
  id            BigInt   @id @default(autoincrement())
  deviceId      Int      @map("device_id")
  soilMoisture  Decimal  @map("soil_moisture") @db.Decimal(5, 2)
  temperature   Decimal  @db.Decimal(5, 2)
  humidity      Decimal  @db.Decimal(5, 2)
  fuzzyOutput   Decimal? @map("fuzzy_output") @db.Decimal(5, 2)
  batteryVoltage Decimal? @map("battery_voltage") @db.Decimal(6, 2)
  rssi          Int?
  timestamp     DateTime @default(now())

  // Relations
  device Device @relation(
    fields: [deviceId],
    references: [id],
    onDelete: Cascade,
    onUpdate: Cascade
  )

  @@index([deviceId, timestamp])
  @@index([timestamp])
  @@map("sensor_readings")
}


// ============================================================
// 5. IRRIGATION SESSIONS
// ============================================================

model IrrigationSession {
  id        BigInt @id @default(autoincrement())
  requestId String @unique @map("request_id") @db.VarChar(50)

  mode    IrrigationMode
  trigger IrrigationTrigger
  status  IrrigationSessionStatus @default(QUEUED)

  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")

  createdBy Int? @map("created_by")

  // Relations
  user User? @relation(
    fields: [createdBy],
    references: [id],
    onDelete: SetNull,
    onUpdate: Cascade
  )

  irrigationLogs IrrigationLog[]

  @@index([status])
  @@index([startedAt])
  @@index([createdBy])
  @@map("irrigation_sessions")
}


// ============================================================
// 6. IRRIGATION LOGS
// ============================================================

model IrrigationLog {
  id         BigInt @id @default(autoincrement())
  sessionId  BigInt @map("session_id")
  zoneId     Int    @map("zone_id")
  sequenceNo Int    @map("sequence_no")

  startTime DateTime? @map("start_time")
  endTime   DateTime? @map("end_time")

  // Actual irrigation duration in seconds
  duration Int?

  status    IrrigationLogStatus @default(QUEUED)
  requestId String              @map("request_id") @db.VarChar(50)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  session IrrigationSession @relation(
    fields: [sessionId],
    references: [id],
    onDelete: Cascade,
    onUpdate: Cascade
  )

  zone Zone @relation(
    fields: [zoneId],
    references: [id],
    onDelete: Restrict,
    onUpdate: Cascade
  )

  @@index([sessionId, sequenceNo])
  @@index([zoneId, startTime])
  @@index([requestId])
  @@map("irrigation_logs")
}


// ============================================================
// 7. SCHEDULES
// ============================================================

model Schedule {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100)

  scheduleType ScheduleType @map("schedule_type")

  // Prisma uses DateTime for MySQL TIME.
  // Stored as TIME in database.
  scheduleTime DateTime @map("time") @db.Time

  // For RECURRING:
  // Example: ["MONDAY", "WEDNESDAY", "FRIDAY"]
  //
  // For ONCE:
  // This field should be NULL.
  days Json?

  // For ONCE:
  // This field contains the execution date.
  //
  // For RECURRING:
  // This field should be NULL.
  scheduleDate DateTime? @map("date") @db.Date

  mode    ScheduleMode
  enabled Boolean @default(true)

  // Used for offline schedule synchronization.
  version Int @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  scheduleZones ScheduleZone[]

  @@index([enabled, scheduleTime])
  @@map("schedules")
}


// ============================================================
// 8. SCHEDULE ZONES
// ============================================================

model ScheduleZone {
  id         Int     @id @default(autoincrement())
  scheduleId Int     @map("schedule_id")
  zoneId     Int     @map("zone_id")
  duration   Int?
  sequenceNo Int     @map("sequence_no")
  enabled    Boolean @default(true)

  // Relations
  schedule Schedule @relation(
    fields: [scheduleId],
    references: [id],
    onDelete: Cascade,
    onUpdate: Cascade
  )

  zone Zone @relation(
    fields: [zoneId],
    references: [id],
    onDelete: Cascade,
    onUpdate: Cascade
  )

  // A zone can only appear once in a schedule.
  @@unique([scheduleId, zoneId])

  // Sequence number must be unique within one schedule.
  @@unique([scheduleId, sequenceNo])

  @@index([scheduleId])
  @@index([zoneId])
  @@map("schedule_zones")
}


// ============================================================
// 9. SYSTEM SETTINGS
// ============================================================

model SystemSetting {
  id          Int    @id @default(autoincrement())
  settingKey  String @unique @map("setting_key") @db.VarChar(100)
  settingValue String @map("setting_value") @db.VarChar(255)

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}


// ============================================================
// 10. AUDIT LOGS
// ============================================================

model AuditLog {
  id BigInt @id @default(autoincrement())

  userId Int? @map("user_id")

  action     String  @db.VarChar(100)
  resource   String  @db.VarChar(100)
  resourceId String? @map("resource_id") @db.VarChar(50)

  requestId String? @map("request_id") @db.VarChar(50)

  details Json?

  ipAddress String? @map("ip_address") @db.VarChar(45)

  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(
    fields: [userId],
    references: [id],
    onDelete: SetNull,
    onUpdate: Cascade
  )

  @@index([userId, createdAt])
  @@index([requestId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}


// ============================================================
// 11. MQTT LOGS
// ============================================================

model MqttLog {
  id BigInt @id @default(autoincrement())

  topic     String        @db.VarChar(255)
  direction MqttDirection

  payload Json

  deviceId Int? @map("device_id")
  requestId String? @map("request_id") @db.VarChar(50)

  timestamp DateTime @default(now())

  // Relations
  device Device? @relation(
    fields: [deviceId],
    references: [id],
    onDelete: SetNull,
    onUpdate: Cascade
  )

  @@index([deviceId, timestamp])
  @@index([requestId])
  @@index([topic, timestamp])
  @@map("mqtt_logs")
}